{
  "name": "@rubenchodev/materix-react",
  "version": "0.1.0",
  "description": "React components with the Material UI (Material Design 2) look of Materix UI: native React, TypeScript, shared CSS and design tokens.",
  "keywords": [
    "react",
    "react-components",
    "material-ui",
    "mui",
    "material-design",
    "material-design-2",
    "ui",
    "components",
    "design-system",
    "accessibility",
    "a11y",
    "dark-mode",
    "typescript"
  ],
  "homepage": "https://qualitycode.dev/materix-ui/react-js/",
  "bugs": {
    "url": "https://github.com/rubenchodev/materix-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubenchodev/materix-ui.git"
  },
  "license": "MIT",
  "author": "Rubén Sánchez LYD",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:examples && playwright test",
    "test:e2e:install": "playwright install chromium",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:examples": "vite build --mode examples",
    "docs:islands": "vite build -c vite.docs.config.ts",
    "docs:build": "npm run docs:islands && hugo -s docs --minify",
    "docs:dev": "npm run docs:islands && hugo server -s docs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@rubenchodev/materix-ui": "^0.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
